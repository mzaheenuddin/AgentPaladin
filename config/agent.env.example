# Copy to config/agent.env and adjust. This file must never contain secrets.

# Target project directory.
# Optional: if left empty or unset, Paladin defaults to the directory you run it from!
# This allows running 'paladin' across any project on your machine.
# PROJECT_DIR=/Users/you/projects/my-app

STATE_DIR=~/.local/state/agent-paladin

# snapshot | direct | direct-commit
WORKSPACE_MODE=snapshot

# run | project
STATE_MODE=run

# deny | allowlist | broker
# deny      = no sandbox egress except the authenticated LLM gateway
# allowlist = package/docs proxy only (domain-level, no TLS inspection)
# broker    = human-approved API broker only (recommended for real APIs)
SANDBOX_EGRESS=deny

# Used only with SANDBOX_EGRESS=allowlist. Keep this list minimal.
SANDBOX_ALLOWED_DOMAINS=

# on | off. "off" is refused unless --unsafe-no-firewall is passed.
SANDBOX_FIREWALL=on

# runc | runsc (runsc only where gVisor is installed)
SANDBOX_RUNTIME=runc

# Prompt DLP action: block | redact
DLP_ACTION=block

DEFAULT_MODEL=deepseek-v4-flash

# Required for --profile confidential. Acknowledges that the external model
# provider receives the confidential code. This is a provider-trust decision.
EXTERNAL_MODEL_ACK=0
