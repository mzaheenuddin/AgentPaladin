{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "update": "disable",
  "snapshots": false,
  "formatter": false,
  "instructions": ["/etc/opencode/AGENTS.md"],
  "providers": {
    "litellm": {
      "name": "Agent Paladin LLM Gateway",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://llm-gateway:24080/v1",
        "apiKey": "{env:LITELLM_GATEWAY_KEY}",
        "headerTimeout": 300000,
        "chunkTimeout": 900000
      },
      "models": {}
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "litellm", "effect": "allow" },
    { "action": "integration.use", "resource": "mcp:*", "effect": "deny" },
    { "action": "integration.use", "resource": "plugin:*", "effect": "deny" },
    { "action": "integration.use", "resource": "skill:*", "effect": "deny" },
    { "action": "tool.use", "resource": "webfetch:*", "effect": "deny" },
    { "action": "tool.use", "resource": "websearch:*", "effect": "deny" },
    { "action": "tool.use", "resource": "external_directory:*", "effect": "deny" }
  ],
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519", "effect": "deny" },
    { "action": "read", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.pypirc", "effect": "deny" },
    { "action": "read", "resource": "*.netrc", "effect": "deny" },
    { "action": "read", "resource": "*credentials.json", "effect": "deny" },
    { "action": "read", "resource": "*service-account*.json", "effect": "deny" },
    { "action": "read", "resource": "*terraform.tfstate*", "effect": "deny" },
    { "action": "read", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "*.git/*", "effect": "deny" },
    { "action": "edit", "resource": "*.opencode/*", "effect": "deny" },
    { "action": "edit", "resource": "*opencode.json*", "effect": "deny" },
    { "action": "edit", "resource": "*AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "*.github/workflows/*", "effect": "deny" },
    { "action": "edit", "resource": "*.github/actions/*", "effect": "deny" },
    { "action": "edit", "resource": "*.gitlab-ci.yml", "effect": "deny" },
    { "action": "edit", "resource": "*Jenkinsfile", "effect": "deny" },
    { "action": "edit", "resource": "*.vscode/tasks.json", "effect": "deny" },
    { "action": "edit", "resource": "*.devcontainer/*", "effect": "deny" }
  ]
}
