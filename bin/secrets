#!/usr/bin/env python3
"""Create, inspect, and rotate the local secret files."""

from __future__ import annotations

import argparse
import getpass
import os
import re
import secrets
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts"))

from common import ROOT, ensure_dir  # noqa: E402

SECRETS = ROOT / "secrets"
BROKER_SECRETS = SECRETS / "broker"

OPTIONAL_PROVIDER_KEYS = [
    "DEEPSEEK_API_KEY",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
]
REQUIRED_GENERATED = ["GATEWAY_TOKEN", "LITELLM_MASTER_KEY"]
BROKER_KEYS = ["GITHUB_TOKEN"]


def secret_path(name: str) -> Path:
    if name in BROKER_KEYS:
        return BROKER_SECRETS / name
    return SECRETS / name


def _open_secret(path: Path, flags: int, mode: int = 0o600) -> int:
    flags |= getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags, mode)
    os.fchmod(fd, 0o600)
    return fd


def write_secret(name: str, value: str) -> None:
    if SECRETS.is_symlink() or BROKER_SECRETS.is_symlink():
        raise SystemExit("refusing to write into a symlinked secrets directory")
    path = secret_path(name)
    ensure_dir(path.parent, 0o700)
    if path.is_symlink():
        raise SystemExit(f"refusing to write through a symlink: {path}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    try:
        fd = _open_secret(path, flags)
    except OSError as exc:
        raise SystemExit(f"cannot write secret {path}: {exc}") from exc
    with open(fd, "w", encoding="utf-8") as handle:
        handle.write(value.strip() + "\n")
    print(f"wrote {path.relative_to(ROOT)}")


def generate(name: str) -> None:
    if name == "LITELLM_MASTER_KEY":
        write_secret(name, "sk-" + secrets.token_hex(32))
    elif name == "GATEWAY_TOKEN":
        write_secret(name, secrets.token_hex(32))
    else:
        raise SystemExit(f"no generator for {name}")


def init() -> int:
    for directory in (SECRETS, BROKER_SECRETS):
        if directory.is_symlink():
            raise SystemExit(f"refusing to use a symlinked secrets directory: {directory}")
    ensure_dir(SECRETS, 0o700)
    ensure_dir(BROKER_SECRETS, 0o700)
    for name in REQUIRED_GENERATED:
        path = secret_path(name)
        if path.is_symlink():
            raise SystemExit(f"refusing to use a symlinked secret path: {path}")
        if not path.exists() or path.stat().st_size == 0:
            generate(name)
        else:
            value = path.read_text(encoding="utf-8").strip()
            if any(char in value for char in "\"'\\\r\n"):
                raise SystemExit(
                    f"existing {name} contains unsafe characters; run bin/secrets rotate {name}"
                )
            if name == "GATEWAY_TOKEN" and not re.fullmatch(
                r"[A-Za-z0-9_-]{16,128}", value
            ):
                raise SystemExit(
                    "existing GATEWAY_TOKEN is too weak; run bin/secrets rotate GATEWAY_TOKEN"
                )
            if name == "LITELLM_MASTER_KEY" and not re.fullmatch(
                r"sk-[A-Za-z0-9_-]{16,}", value
            ):
                raise SystemExit(
                    "existing LITELLM_MASTER_KEY is weak or malformed; "
                    "run bin/secrets rotate LITELLM_MASTER_KEY"
                )
            path.chmod(0o600)
            print(f"kept {path.relative_to(ROOT)}")
    for name in OPTIONAL_PROVIDER_KEYS + BROKER_KEYS:
        path = secret_path(name)
        ensure_dir(path.parent, 0o700)
        if path.is_symlink():
            raise SystemExit(f"refusing to use a symlinked secret path: {path}")
        if not path.exists():
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            fd = _open_secret(path, flags)
            os.close(fd)
            print(f"created empty {path.relative_to(ROOT)}")
        else:
            path.chmod(0o600)
    print("\nRequired generated secrets are ready.")
    print("Set a provider key with: bin/secrets set DEEPSEEK_API_KEY")
    return 0


def set_secret(name: str) -> int:
    name = name.upper()
    if name not in REQUIRED_GENERATED + OPTIONAL_PROVIDER_KEYS + BROKER_KEYS:
        print(f"error: unsupported secret name: {name}", file=sys.stderr)
        return 2
    if not sys.stdin.isatty():
        print("error: refusing to read a secret from a non-interactive stdin", file=sys.stderr)
        return 2
    value = getpass.getpass(f"{name}: ").strip()
    if not value:
        print("error: empty value", file=sys.stderr)
        return 2
    if any(char in value for char in "\"'\\\r\n"):
        print("error: secret contains characters unsafe for configuration headers", file=sys.stderr)
        return 2
    if name == "LITELLM_MASTER_KEY" and not re.fullmatch(
        r"sk-[A-Za-z0-9_-]{16,}", value
    ):
        print(
            "error: LITELLM_MASTER_KEY must be sk- followed by 16+ safe characters",
            file=sys.stderr,
        )
        return 2
    if name == "GATEWAY_TOKEN" and not re.fullmatch(r"[A-Za-z0-9_-]{16,128}", value):
        print(
            "error: GATEWAY_TOKEN must be 16-128 characters of [A-Za-z0-9_-]",
            file=sys.stderr,
        )
        return 2
    write_secret(name, value)
    return 0


def rotate(name: str) -> int:
    name = name.upper()
    if name in {"GATEWAY_TOKEN", "LITELLM_MASTER_KEY"}:
        generate(name)
        print("Rotate the gateway/sandbox after changing the gateway token.")
        return 0
    return set_secret(name)


def list_secrets() -> int:
    values: list[tuple[str, str]] = []
    for name in REQUIRED_GENERATED + OPTIONAL_PROVIDER_KEYS + BROKER_KEYS:
        path = secret_path(name)
        if not path.exists():
            values.append((name, "missing"))
        elif path.stat().st_size == 0:
            values.append((name, "empty"))
        else:
            values.append((name, "set"))
    for name, status in values:
        print(f"{name:<24} {status}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=["init", "set", "rotate", "list"])
    parser.add_argument("name", nargs="?")
    args = parser.parse_args(argv)

    if args.command == "init":
        return init()
    if args.command == "list":
        return list_secrets()
    if not args.name:
        parser.error(f"{args.command} requires a secret name")
    if args.command == "set":
        return set_secret(args.name)
    if args.command == "rotate":
        return rotate(args.name)
    return 2


if __name__ == "__main__":
    sys.exit(main())
